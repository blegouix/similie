#pragma once

#include <array>
#include <cmath>
#include <type_traits>

#include <similie/exterior/form.hpp>
#include <similie/physics/concepts.hpp>
#include <similie/physics/coupling/electric_coupling_physics.hpp>

#include <Kokkos_Core.hpp>

namespace similie::physics::electrodynamics {
/** Electric quasistatic sector with advected charge, zero conductivity.
 * H(D)=D.D/(2 epsilon), E=H_D=-grad(phi), -div(epsilon grad phi)=charge.
 * charge_t=-div J, J=charge*u. No magnetic induction or Maxwell-wave state.
 * Magnetic induction is stationary and omitted in this zero-background model.
 * The caller reconstructs the potential with native exterior elliptic operators.
 * \important This operator and documentation is fully AI-generated.
 */
class Electrodynamics
{
public:
    using Scalar = sil::exterior::Form<double>;
    using Vector = sil::exterior::Form<std::array<double, 3>>;
    static constexpr std::size_t N = 4;
    static constexpr bool IS_LINEAR = true;
    struct State
    {
        Scalar charge_density {};
        Vector displacement {};
    };
    double const permittivity;
    KOKKOS_FUNCTION explicit Electrodynamics(double electric_permittivity)
        : permittivity(electric_permittivity)
    {
        KOKKOS_ASSERT(permittivity > 0);
    }
    KOKKOS_FUNCTION static Scalar dot(Vector const& left, Vector const& right)
    {
        double result = 0;
        for (int a = 0; a < 3; ++a)
            result += left[a] * right[a];
        return Scalar(result);
    }
    KOKKOS_FUNCTION Scalar hamiltonian(Vector const& displacement) const
    {
        return Scalar(@energy@);
    }
    KOKKOS_FUNCTION Vector electric_field(Vector const& displacement) const
    {
        return @electric_field@;
    }
    KOKKOS_FUNCTION Vector field_from_potential_gradient(Vector const& potential_gradient) const
    {
        Vector result {};
        for (int a = 0; a < 3; ++a)
            result[a] = -potential_gradient[a];
        return result;
    }
    KOKKOS_FUNCTION Vector displacement(Vector const& electric) const
    {
        Vector result {};
        for (int a = 0; a < 3; ++a)
            result[a] = permittivity * electric[a];
        return result;
    }
    KOKKOS_FUNCTION Vector conduction_current([[maybe_unused]] Vector const& displacement) const
    {
        return {};
    }
    KOKKOS_FUNCTION Vector
    current(Scalar const& charge_density,
            Vector const& velocity,
            [[maybe_unused]] Vector const& displacement) const
    {
        Vector result {};
        for (int a = 0; a < 3; ++a)
            result[a] = charge_density * velocity[a];
        return result;
    }
    KOKKOS_FUNCTION Scalar operator()(Scalar const& current_divergence) const
    {
        return Scalar(-current_divergence);
    }
    KOKKOS_FUNCTION Vector
    electric_force(Scalar const& charge_density, Vector const& displacement) const
    {
        return coupling::ElectricCouplingPhysics()(
                       {charge_density, electric_field(displacement), {}, {}})
                .momentum_source;
    }
    KOKKOS_FUNCTION Scalar
    fluid_energy_source(Vector const& displacement, Vector const& total_current) const
    {
        return Scalar(
                coupling::ElectricCouplingPhysics()(
                        {Scalar(0), electric_field(displacement), {}, total_current})
                        .fluid_energy_source);
    }
    KOKKOS_FUNCTION Scalar ohmic_heating([[maybe_unused]] Vector const& displacement) const
    {
        return Scalar(0);
    }
    KOKKOS_FUNCTION double charge_relaxation_rate() const
    {
        return 0;
    }
    KOKKOS_FUNCTION Scalar
    gauss_residual(Scalar const& displacement_divergence, Scalar const& charge_density) const
    {
        return Scalar(displacement_divergence - charge_density);
    }
};

static_assert(PhysicsConcept<Electrodynamics>);
} // namespace similie::physics::electrodynamics
